# TruthLens AI Frontend Environment Variables (Netlify)
# In production on Netlify, set VITE_API_URL to your deployed Render backend URL:
# Example: VITE_API_URL=https://truthlens-server.onrender.com
# In local development, leave blank or omit to use Vite's local dev proxy to localhost:5000
VITE_API_URL=
